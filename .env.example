# Copy this file to `.env` and adjust for your environment.
# docker-compose.yml reads these automatically. All values have safe dev
# defaults baked in, so the stack runs without a .env — override them for any
# shared or production deployment.

# Base64-encoded 256-bit (32-byte) secret used to sign/verify JWTs.
# Generate a fresh one with:  openssl rand -base64 32
LEDGER_JWT_SECRET=c2VjdXJlLWRldi1zZWNyZXQtY2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tMTIzNDU2

# Postgres password (used by both the database and the backend).
POSTGRES_PASSWORD=ledger
